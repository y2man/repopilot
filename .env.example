# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
APP_ENV=production
# Local Compose uses POSTGRES_PASSWORD. For Neon/Render, set DATABASE_URL directly in Render.
# Neon connection strings using postgresql:// are normalized to psycopg by the backend.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Set REDIS_URL to the Render Key Value internal URL in production.
# REDIS_URL=rediss://...
POSTGRES_PASSWORD=replace-with-a-long-random-password
INSTALL_LOCAL_EMBEDDINGS=true
RERANKER_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional GitHub OAuth app credentials. Callback: https://YOUR_DOMAIN/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional GitHub webhook signing secret; configure a push webhook at /api/v1/webhooks/github
GITHUB_WEBHOOK_SECRET=
# Optional fallback PAT for a single-operator deployment; OAuth per-user is preferred.
GITHUB_TOKEN=
FRONTEND_URL=https://YOUR_DOMAIN
PUBLIC_API_URL=https://YOUR_DOMAIN
CORS_ORIGINS=["https://YOUR_DOMAIN"]
ALLOWED_HOSTS=["YOUR_DOMAIN","localhost","127.0.0.1"]
MAX_UPLOAD_MB=100
AUDIT_RETENTION_DAYS=365

# Isolated test runner (use a separate dedicated Linux VM for production)
SANDBOX_SHARED_SECRET=replace-with-a-different-long-random-secret
# For a dedicated runner VM, set this to its private URL (e.g. http://10.0.0.5:8090)
SANDBOX_URL=http://sandbox:8090
# Docker socket group ID on the host (Linux: stat -c %g /var/run/docker.sock)
DOCKER_GID=999
